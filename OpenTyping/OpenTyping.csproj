<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenTyping</RootNamespace>
    <!-- Debug·Release 공통 어셈블리 이름. build.bat도 이 이름 그대로 게시한 뒤
         "파일"만 열린타자+.exe로 복사-개명한다 (<260831>: 어셈블리 이름에 '+'가
         들어가면 WPF 내부 리소스 pack URI가 깨져 XAML 창 생성이
         ArgumentNullException(partUri)으로 실패함 - 단일 파일 Release에서 5/5 재현). -->
    <AssemblyName>열린타자플러스</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyTitle>Open Typing Plus</AssemblyTitle>
    <Product>Open Typing Plus</Product>
    <Copyright>Copyright © 2018</Copyright>
    <!-- <2600912_5>: 메이저 자리는 0 고정, 사용자가 직접 지시하기 전까지 1로 올리지 않는다.
         Minor.Build.Revision은 Claude가 자동으로 올린다. -->
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <!-- <2600912_5-1>: '프로그램 정보' 창은 이제 AssemblyVersion(VersionInfo.cs)을 그대로 표시하므로
         이 값을 안 쓴다. build-exe.bat이 Inno Setup 설치 프로그램의 AppVersion(3자리)으로 쓰려고
         findstr로 이 줄을 직접 읽으므로 남겨 둔다 — 지우면 설치 파일 빌드가 실패한다. -->
    <DisplayVersion>0.5.0</DisplayVersion>
  </PropertyGroup>

  <!-- 빌드 시각을 컴파일 시점 기준으로 어셈블리 메타데이터에 자동 주입한다.
       '프로그램 정보' 창이 AssemblyMetadata("BuildTimestamp")로 읽어 "빌드: yyyy-MM-dd HH:mm"로 표시.
       매 빌드마다 값이 바뀌어 항상 재컴파일되지만(증분 빌드 무효화), 정보 표기 목적상 허용한다. -->
  <Target Name="SetBuildTimestamp" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <BuildTimestamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildTimestamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestamp</_Parameter1>
        <_Parameter2>$(BuildTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Modern" Version="6.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\NanumGothic.ttf" />
    <Resource Include="Resources\Fonts\NanumGothicBold.ttf" />
    <Resource Include="Resources\Fonts\NanumGothicExtraBold.ttf" />
    <Resource Include="Resources\Fonts\NanumBarunGothic.ttf" />
    <Resource Include="Resources\Fonts\NanumBarunGothicBold.ttf" />
    <Resource Include="Resources\Fonts\NanumBarunGothicLight.ttf" />
    <Resource Include="Resources\Fonts\NanumBarunGothicUltraLight.ttf" />
    <Resource Include="Resources\icon.png" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 자리연습 순3·순4 제시어(한 글자 조합/2음절 이상 단어). 단일 파일 게시의 데이터 복사
         함정을 피하려고 파일이 아닌 어셈블리 내장 리소스로 넣는다 (<260723_4>). -->
    <EmbeddedResource Include="Resources\jariyeonseup_words.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 산성비 게임(오락) 단어 목록. 게임은 자체 words.json을 유지하며(사용자 편집 가능),
         실행 파일 옆 game\words.json에서 읽는다. dev 빌드는 이 Content 복사로, 배포(single-file)는
         build.bat이 소스에서 직접 robocopy 한다(단일 파일 게시 데이터 복사 함정 회피, <260723_2>). -->
    <Content Include="game\words.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 자판별 연습 단계 정의 (<260724_1>(3)). 실행 파일 옆 stages\*.json을 개발자가 편집할 수 있게
         Content로 복사하고, 파일이 없거나 깨졌을 때를 대비해 같은 파일을 내장 리소스로도 넣어 폴백한다.
         배포(single-file)는 build.bat이 소스에서 직접 robocopy 한다. -->
    <Content Include="stages\dubeolsik_standard.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="stages\dubeolsik_standard.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- <260811_26>(2-1) 손 모델 3D에서 "손 모양 json 추출"로 만든 손가락 레이어 벡터(SVG).
         실행 파일 옆 hands\*.svg 를 사용한다. 지금은 기본 자세(home-left/right) 테스트 1쌍뿐이며,
         이후 단계에서 물리 키별 파일이 늘어난다. game/stages 와 같은 이유로 dev 빌드는 이 Content
         복사로, 배포(single-file)는 build.bat이 소스에서 직접 robocopy 한다. -->
    <Content Include="hands\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
