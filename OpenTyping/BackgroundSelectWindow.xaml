<mah:MetroWindow x:Class="OpenTyping.BackgroundSelectWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Style="{StaticResource WindowTitleStyle}"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 Icon="{StaticResource AppIcon}">
    <!-- <261025_4> 자리연습 화면 '오락 열기' 목록의 '배경 선택'을 고르면 뜨는 창(디자인은 '최고 기록' 창과 같다).
         <261026_1>로 그 목록 항목을 뺐다 — 지금은 이 창을 여는 곳이 없다(-acidscenetest 진단만 연다). -->
    <StackPanel Orientation="Vertical"
                Margin="24 16 24 18"
                MinWidth="260">
        <TextBlock Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontWeight="Bold"
                   FontSize="13pt"
                   Text="산성비 타자 오락 배경"
                   Margin="0 0 0 4"/>
        <TextBlock x:Name="KeyboardText"
                   Style="{StaticResource NormalTextBlock}"
                   FontSize="14"
                   Foreground="Gray"
                   Margin="0 0 0 8"/>
        <StackPanel x:Name="ChoicePanel"
                    Orientation="Vertical"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
            <Button x:Name="OkButton" IsDefault="True" Click="Ok_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="확인"/>
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0" Click="Cancel_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="취소"/>
            </Button>
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
