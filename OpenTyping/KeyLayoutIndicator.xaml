<UserControl x:Class="OpenTyping.KeyLayoutIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenTyping"
             mc:Ignorable="d"
             d:DesignWidth="185"
             d:DesignHeight="32">
    <!-- <260927_9>·<260927_10> `자판 표시`: 자판 이름(파랑)과 문자 종류(초록) 사각형 한 쌍.
         원래 '대문' 화면(HomeMenu.xaml)에만 있던 것을 재사용할 수 있게 별도 컨트롤로 뽑았다.
         <260927_13>: 클릭하면 '설정' 창이 열린다(MainWindow가 Click 이벤트를 구독). -->
    <StackPanel Orientation="Horizontal"
                Cursor="Hand"
                Background="Transparent"
                MouseLeftButtonDown="RootPanel_MouseLeftButtonDown"
                LostMouseCapture="RootPanel_LostMouseCapture"
                MouseLeftButtonUp="RootPanel_MouseLeftButtonUp">
        <Border Background="#4263eb"
                CornerRadius="5"
                HorizontalAlignment="Left"
                Padding="5">
            <StackPanel Orientation="Horizontal">
                <Rectangle Style="{StaticResource TabItemIconRectangle}"
                           Width="35"
                           Height="22"
                           Fill="White"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform"
                                     Visual="{iconPacks:FontAwesome KeyboardSolid}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock x:Name="CurrentKeyLayoutName"
                           Foreground="White"
                           FontFamily="{StaticResource NanumBarunGothic}"
                           FontSize="14pt"
                           Margin="5 0 0 0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Background="#37b24d"
                CornerRadius="5"
                HorizontalAlignment="Left"
                Margin="7 0 0 0"
                Padding="5">
            <StackPanel Orientation="Horizontal">
                <Rectangle Style="{StaticResource TabItemIconRectangle}"
                           Width="47"
                           Height="22"
                           Fill="White"
                           VerticalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform"
                                     Visual="{iconPacks:FontAwesome LanguageSolid}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock x:Name="CurrentKeyLayoutChar"
                           Foreground="White"
                           FontFamily="{StaticResource NanumBarunGothic}"
                           FontSize="14pt"
                           Margin="5 0 0 0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
