<mah:MetroWindow x:Class="OpenTyping.LicenseWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="라이선스"
                 Style="{StaticResource WindowTitleStyle}"
                 FontFamily="{StaticResource NanumGothic}"
                 Width="560"
                 Height="440"
                 MinWidth="480"
                 MinHeight="360"
                 ResizeMode="CanResize"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="True"
                 WindowStartupLocation="CenterOwner"
                 Icon="{StaticResource AppIcon}">
    <Grid Margin="20 16 20 16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource NormalTextBlock}"
                   FontWeight="Bold"
                   FontSize="12pt"
                   Margin="0 0 0 8"
                   Text="MIT License"/>

        <Border Grid.Row="1"
                BorderBrush="#ced4da"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12 10 12 10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LicenseText"
                           FontFamily="Consolas"
                           FontSize="10.5pt"
                           Foreground="#212529"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- 설정 창의 '확인' 버튼과 같은 모양(초록 체크 아이콘 + 텍스트) (<260718_11-1>) -->
        <Button Grid.Row="2"
                x:Name="BackButton"
                HorizontalAlignment="Right"
                Margin="0 12 0 0"
                Click="BackButton_Click">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="18"
                           Height="13"
                           Fill="#2b8a3e">
                    <Rectangle.OpacityMask>
                        <VisualBrush Visual="{iconPacks:Modern check}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Style="{StaticResource ControlButtonText}"
                           Text="확인"/>
            </StackPanel>
        </Button>
    </Grid>
</mah:MetroWindow>
