<mah:MetroWindow x:Name="SelfWindow"
                 x:Class="OpenTyping.SyllablePracticeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:OpenTyping"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Icon="{StaticResource AppIcon}"
                 Height="400"
                 Width="700"
                 MinWidth="700"
                 MinHeight="400"
                 ResizeMode="CanResize">
    <Viewbox Stretch="Uniform">
        <Grid Width="700" Height="370">
    <Grid>
        <Grid.Resources>
            <Style x:Key="PrevNextTextBlock" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource NanumBarunGothic}"/>
                <Setter Property="FontSize" Value="60pt"/>
                <Setter Property="Foreground" Value="#868e96"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   DataContext="{Binding ElementName=SelfWindow}"
                   Style="{StaticResource PrevNextTextBlock}"
                   Text="{Binding Path=PreviousSyllable}"/>

        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="0 0 0 45">
            <StackPanel Orientation="Horizontal"
                        Margin="0 0 0 10"
                        HorizontalAlignment="Center">
                <Rectangle Width="26" 
                           Height="26"
                           Margin="0 0 5 0"
                           Fill="#37b24d">
                    <Rectangle.OpacityMask>
                        <VisualBrush Visual="{iconPacks:FontAwesome Kind=CircleCheckSolid}"/>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock DataContext="{Binding ElementName=SelfWindow}"
                       Style="{StaticResource NormalTextBlock}"
                       Text="{Binding CorrectCount}"
                       Margin="0 3 0 0"
                       FontSize="16pt"/>
            </StackPanel>

            <Border BorderBrush="#868e96"
                    BorderThickness="2"
                    Background="#f1f3f5"
                    CornerRadius="5"
                    Padding="20 7 15 8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel DataContext="{Binding ElementName=SelfWindow}"
                            Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource NanumBarunGothic}"
                               FontSize="80pt"
                               Margin="0 8 30 0"
                               Text="{Binding Path=CurrentSyllable}"/>
                    <!-- 입력된 글자를 코드로 지우면 한글 IME 조합이 깨져 음절이 안 넘어가는
                         버그가 생기므로, 글자는 누적한 채 처리된 글자들을 왼쪽 시야 밖으로
                         밀어내(RenderTransform) 빈 입력 칸처럼 보이게 한다.
                         배경 피드백(흰색/분홍)은 이 Border가 담당한다. -->
                    <Border x:Name="CurrentTextBoxBorder"
                            Width="110"
                            Height="125"
                            Background="#f8f9fa"
                            BorderBrush="#ababab"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <TextBox x:Name="CurrentTextBox"
                                 FontFamily="{StaticResource NanumBarunGothic}"
                                 FontSize="80pt"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 MinWidth="108"
                                 HorizontalAlignment="Left"
                                 SelectionBrush="Transparent"
                                 TextChanged="CurrentTextBox_TextChanged"
                                 CommandManager.PreviewExecuted="CurrentTextBox_PreviewExecuted"
                                 AllowDrop="False"
                                 ContextMenu="{x:Null}">
                            <TextBox.RenderTransform>
                                <TranslateTransform x:Name="HiddenTextTranslate"/>
                            </TextBox.RenderTransform>
                        </TextBox>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
        <TextBlock Grid.Column="2"
                   DataContext="{Binding ElementName=SelfWindow}"
                   Style="{StaticResource PrevNextTextBlock}"
                   Text="{Binding Path=NextSyllable}"/>
    </Grid>
        </Grid>
    </Viewbox>
</mah:MetroWindow>

