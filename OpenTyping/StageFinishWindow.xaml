<mah:MetroWindow x:Class="OpenTyping.StageFinishWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Style="{StaticResource WindowTitleStyle}"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 ShowCloseButton="False"
                 Icon="{StaticResource AppIcon}">
    <!-- <260812_5>, <260812_5-1> 단계 자리연습을 마치면 뜨는 창.
         제목 표시줄에 최소화·최대화·끄기 단추가 없다 — 나가는 길은 '나가기' 버튼뿐이다.
         내용은 세 줄: 타수 / 활성화 안내 / 버튼들. 문구와 버튼 구성은 전부 코드에서 만든다
         (단계 구성·오락 유무·목표 타수가 바뀌어도 그대로 따라가야 하므로). -->
    <StackPanel Orientation="Vertical"
                Margin="24 16 24 18">
        <TextBlock x:Name="TaText"
                   Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontWeight="Bold"
                   FontSize="14pt"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"/>
        <TextBlock x:Name="UnlockText"
                   Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontSize="12pt"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Margin="0 8 0 0"/>

        <!-- <2600919_2> 치트 상태(StageRecords.CheatOn)일 때만 보이는 경고 줄. 훗날 이 사실을
             잊고 "왜 오락·다음 단계가 안 열리지"라며 헤매지 않도록 매번 상기시킨다. -->
        <TextBlock x:Name="CheatWarningText"
                   Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontSize="12pt"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Margin="0 8 0 0"
                   Visibility="Collapsed"/>

        <!-- 버튼 모양은 '→ 연습 시작' 버튼 디자인을 따른다(디자인 통일 원칙 2). -->
        <StackPanel x:Name="ButtonPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 18 0 0"/>
    </StackPanel>
</mah:MetroWindow>
