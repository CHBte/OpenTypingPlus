<mah:MetroWindow x:Class="OpenTyping.HandSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Style="{StaticResource WindowTitleStyle}"
                 Width="430"
                 Height="360"
                 ResizeMode="NoResize"
                 Icon="{StaticResource AppIcon}"
                 Closed="HandSettingsWindow_Closed">
    <StackPanel Orientation="Vertical"
                Margin="18 10 18 10">
        <StackPanel Orientation="Horizontal"
                    Margin="0 0 0 12">
            <Rectangle Width="24"
                       Height="27"
                       Margin="0 0 8 0"
                       Fill="#212529">
                <Rectangle.OpacityMask>
                    <VisualBrush Visual="{iconPacks:FontAwesome Kind=HandRegular}"/>
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock Style="{StaticResource NormalTextBlock}"
                       Text="손 모양"
                       FontSize="20pt"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <DockPanel Margin="0 0 0 10"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource NormalTextBlock}"
                       Text="손가락 레이어"
                       FontSize="13pt"
                       VerticalAlignment="Center"/>
            <mah:ToggleSwitch x:Name="EnabledToggle"
                              DockPanel.Dock="Right"
                              VerticalAlignment="Center"
                              Foreground="#212529"
                              OnContent="켬" OffContent="끔"
                              Toggled="EnabledToggle_Toggled"/>
        </DockPanel>

        <DockPanel Margin="0 0 0 10">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource NormalTextBlock}"
                       Text="윤곽선 두께"
                       FontSize="13pt"
                       Width="110"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ThicknessLabel"
                       DockPanel.Dock="Right"
                       Style="{StaticResource NormalTextBlock}"
                       FontSize="12pt"
                       Width="36"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
            <Slider x:Name="ThicknessSlider"
                    Minimum="1"
                    Maximum="8"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="ThicknessSlider_ValueChanged"/>
        </DockPanel>

        <DockPanel Margin="0 0 0 10">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource NormalTextBlock}"
                       Text="윤곽선 투명도"
                       FontSize="13pt"
                       Width="110"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="OpacityLabel"
                       DockPanel.Dock="Right"
                       Style="{StaticResource NormalTextBlock}"
                       FontSize="12pt"
                       Width="48"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
            <Slider x:Name="OpacitySlider"
                    Minimum="10"
                    Maximum="100"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="OpacitySlider_ValueChanged"/>
        </DockPanel>

        <TextBlock Style="{StaticResource NormalTextBlock}"
                   Text="윤곽선 색"
                   FontSize="13pt"
                   Margin="0 0 0 6"/>
        <StackPanel x:Name="ColorSwatchPanel"
                    Orientation="Horizontal"
                    Margin="0 0 0 14"/>

        <StackPanel Style="{StaticResource ControlButtonStackPanel}"
                    Margin="0">
            <Button x:Name="OkButton"
                    Click="OkButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="18"
                               Height="13"
                               Fill="#2b8a3e">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{iconPacks:Modern check}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Style="{StaticResource ControlButtonText}"
                               Text="확인"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
