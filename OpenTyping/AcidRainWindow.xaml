<mah:MetroWindow x:Class="OpenTyping.AcidRainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="산성비 타자 오락"
        Style="{StaticResource WindowTitleStyle}"
        Width="900" Height="680"
        MinWidth="480" MinHeight="360"
        FontFamily="맑은 고딕"
        WindowStartupLocation="CenterScreen"
        Background="#dee2e6">
    <!-- 산성비 게임을 OpenTypingPlus에 통합한 창 (<260723_2>). 원래 독립 프로그램(AcidRain)의
         MainWindow를 그대로 옮기되, 네임스페이스를 OpenTyping으로 바꾸고 App 리소스에 의존하던
         팔레트/버튼 스타일을 이 창 안에 내장했다. 단어 목록은 제시어 목록(WordCatalog,
         wordslist\words.json), 오락 해금은 StageRecords(자리연습 목표 타수)로 일원화한다.
         <2600919_5> 다른 모든 창처럼 mah:MetroWindow로 바꿔 파란 테두리·제목표시줄 높이·색과
         제목 글씨 스타일(WindowTitleStyle)을 그대로 물려받는다(디자인 통일 원칙). -->
    <mah:MetroWindow.Resources>
        <!-- 팔레트: OpenTypingPlus 강조색(#1c7ed6)·회색 계열(디자인 통일 원칙) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1c7ed6"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1864ab"/>
        <SolidColorBrush x:Key="InkBrush" Color="#212529"/>
        <SolidColorBrush x:Key="SubInkBrush" Color="#495057"/>
        <SolidColorBrush x:Key="LineBrush" Color="#dee2e6"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22 9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>
    <!-- 창 크기를 바꿔도 낙하 거리 대 글자 크기의 비율(게임의 핵심 요소)이 항상 같도록,
         고정 해상도(900x680) 화면 전체를 Viewbox로 통째 확대/축소한다. -->
    <Viewbox Stretch="Uniform">
    <Grid Width="900" Height="680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 HUD -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0 0 0 1"
                Padding="14 8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StageNameText" Text="—" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LevelText" Text="  레벨 1" FontSize="15"
                               Foreground="{StaticResource SubInkBrush}" VerticalAlignment="Center" Margin="14 0 0 0"/>
                </StackPanel>
                <!-- 연속 성공 문구는 HUD 가운데 (<산성비 타자 오락 260812_19>(2)). 단계·레벨 글자 길이에 상관없이
                     늘 같은 자리에 오도록 왼쪽 묶음에서 떼어 내 Grid 가운데에 겹쳐 놓는다. -->
                <TextBlock x:Name="ComboText" Text="" FontSize="15" FontWeight="Bold"
                           Foreground="#f76707"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ScoreText" Text="점수 0" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0 0 18 0"/>
                    <TextBlock x:Name="LivesText" Text="●●●●●●●●●●" FontSize="13" Foreground="#1c7ed6"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 게임 영역 (특수 이벤트 '화면 흔들림'을 위해 코드에서 RenderTransform을 단다) -->
        <Grid Grid.Row="1" x:Name="GameArea">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="SkyTopStop" Color="#d0ebff" Offset="0"/>
                    <GradientStop x:Name="SkyBottomStop" Color="#f8fbff" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <!-- 땅 위 배경 장식(산·나무·꽃·동물·사람). 단계가 오를수록 코드에서 누적해 추가한다. -->
            <!-- 겹치는 차례를 선언 순서가 아니라 ZIndex 로 못박는다 (<산성비 타자 오락 260812_26>).
                 배경 장식(0) < 안내 배너(10) < 산성비(20) < 땅(30). 배너가 산성비보다 뒤라
                 떨어지는 글자를 가리지 않는다. 필요할 때만 코드에서 앞으로(40) 올린다. -->
            <Canvas x:Name="SceneryLayer" Height="90" VerticalAlignment="Bottom" IsHitTestVisible="False"
                    Panel.ZIndex="0"/>
            <Canvas x:Name="GameCanvas" ClipToBounds="True" Panel.ZIndex="20"/>
            <Border x:Name="GroundStrip" Height="26" VerticalAlignment="Bottom"
                    Background="#69db7c" BorderBrush="#2f9e44" BorderThickness="0 2 0 0"
                    IsHitTestVisible="False" Panel.ZIndex="30"/>
            <!-- 조작 안내 (<산성비 타자 오락 260812_16>(2)): 땅(초록 띠) 안, 즉 산성비가 닿는 경계선 아래에 둔다. -->
            <Grid Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False" Margin="14 0 14 0"
                  Panel.ZIndex="31">
                <TextBlock Text="일시정지 [Esc]" FontSize="12" Foreground="White"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="단어 입력 후 [Enter]/[Space]" FontSize="12" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <!-- <261005_4> 영문 산성비에서 [Caps Lock]이 켜져 있으면 두 안내 사이 가운데에 빨간 경고를 띄운다
                     (코드의 RefreshCapsLockWarning). 사용자가 일부러 켰을 수도 있으므로 경고만 하고 입력·판정은 그대로다. -->
                <TextBlock x:Name="CapsLockWarningText" Text="Caps Lock이 켜져 있습니다." FontSize="12" FontWeight="Bold"
                           Foreground="#f03e3e" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <!-- 특수 이벤트·레벨업 안내 배너 (코드에서 페이드 애니메이션) -->
            <!-- 폭죽·불꽃 (<산성비 타자 오락 260812_24-1>, <산성비 타자 오락 260812_28>): 산성비(20)보다 앞이면서 문구(40)보다는 뒤(38). -->
            <Canvas x:Name="FireworkLayer" ClipToBounds="True" IsHitTestVisible="False" Panel.ZIndex="38"/>
            <TextBlock x:Name="EventBanner" Text="" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 200"
                       Opacity="0" IsHitTestVisible="False"
                       Panel.ZIndex="10"/>
        </Grid>

        <!-- 입력 영역 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0 1 0 0"
                Padding="14 10">
            <!-- 조작 안내는 땅 그림 위로 옮겼다 (<산성비 타자 오락 260812_16>(2)). -->
            <TextBox x:Name="InputBox" FontSize="19" Padding="8 5"
                     TextAlignment="Center"
                     BorderBrush="{StaticResource LineBrush}"
                     PreviewKeyDown="InputBox_PreviewKeyDown"
                     CommandManager.PreviewExecuted="InputBox_PreviewExecuted"
                     AllowDrop="False"
                     ContextMenu="{x:Null}"/>
        </Border>

        <!-- 시작 오버레이 -->
        <Grid x:Name="StartOverlay" Grid.RowSpan="3" Background="#E6FFFFFF">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="36 28">
                <StackPanel MinWidth="330">
                    <TextBlock Text="산성비 타자 오락" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="하늘에서 떨어지는 단어를 땅에 닿기 전에 입력하세요!" FontSize="13"
                               Foreground="{StaticResource SubInkBrush}" HorizontalAlignment="Center" Margin="0 8 0 22"/>
                    <TextBlock Text="연습 단계 (단어 목록)" FontSize="13" FontWeight="Bold" Margin="0 0 0 6"/>
                    <ComboBox x:Name="StageCombo" FontSize="14" Padding="8 6"
                              SelectionChanged="StageCombo_SelectionChanged"/>
                    <TextBlock x:Name="BestRecordText" Text="최고 기록이 아직 없습니다" FontSize="12"
                               Foreground="{StaticResource SubInkBrush}" HorizontalAlignment="Center" Margin="0 10 0 0"/>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="→ 게임 시작"
                            Margin="0 16 0 0" Click="StartButton_Click"/>
                    <TextBlock Text="단어 입력 후 [Enter]/[Space] / 일시정지 [Esc]" FontSize="12"
                               Foreground="{StaticResource SubInkBrush}" HorizontalAlignment="Center" Margin="0 12 0 0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 일시정지 오버레이 -->
        <Grid x:Name="PauseOverlay" Grid.RowSpan="3" Background="#B3FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="일시정지" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="[Esc]를 다시 누르면 계속합니다" FontSize="14"
                           Foreground="{StaticResource SubInkBrush}" HorizontalAlignment="Center" Margin="0 10 0 0"/>
                <Button x:Name="QuitButton" Style="{StaticResource PrimaryButton}" Content="→ 처음 화면으로"
                        Margin="0 20 0 0" HorizontalAlignment="Center" Click="QuitButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 게임 종료 오버레이 -->
        <Grid x:Name="GameOverOverlay" Grid.RowSpan="3" Background="#E6FFFFFF" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="36 28">
                <StackPanel MinWidth="330">
                    <TextBlock Text="게임 종료" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultText" FontSize="15" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center" Margin="0 16 0 0" TextAlignment="Center" LineHeight="26"/>
                    <TextBlock x:Name="NewRecordText" Text="★ 신기록 달성!" FontSize="17" FontWeight="Bold"
                               Foreground="#f76707" HorizontalAlignment="Center" Margin="0 12 0 0"
                               Visibility="Collapsed"/>
                    <Grid Margin="0 18 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RetryButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                Content="다시 하기" Click="RetryButton_Click"/>
                        <Button x:Name="GameOverQuitButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Content="나가기" Click="GameOverQuitButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Viewbox>
</mah:MetroWindow>
