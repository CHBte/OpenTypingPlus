<mah:MetroWindow x:Class="OpenTyping.CheatStageWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Style="{StaticResource WindowTitleStyle}"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 Icon="{StaticResource AppIcon}">
    <!-- <260812_10> 치트코드를 입력했을 때 '몇 단계까지 통과한 것으로 칠지' 고르는 창. -->
    <StackPanel Orientation="Vertical"
                Margin="24 16 24 18">
        <TextBlock Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontWeight="Bold"
                   FontSize="13pt"
                   Text="몇 단계까지 통과한 것으로 할까요?"/>
        <TextBlock x:Name="HintText"
                   Style="{StaticResource NormalTextBlock}"
                   FontSize="10pt"
                   Foreground="#868e96"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   Margin="0 6 0 0"/>

        <ComboBox x:Name="StageCombo"
                  Margin="0 14 0 0"
                  MinWidth="220"
                  HorizontalAlignment="Left"/>

        <!-- <260812_12> 자리연습의 타속 계산 방법 고르기 -->
        <Rectangle Height="1" Fill="#dee2e6" Margin="0 18 0 0"/>
        <TextBlock Style="{StaticResource NormalTextBlock}"
                   FontFamily="{StaticResource NanumGothic}"
                   FontWeight="Bold"
                   FontSize="13pt"
                   Text="타속 계산 방법"
                   Margin="0 14 0 0"/>
        <TextBlock x:Name="MethodText"
                   Style="{StaticResource NormalTextBlock}"
                   FontSize="10pt"
                   Foreground="#868e96"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   Margin="0 6 0 0"/>
        <StackPanel Orientation="Horizontal"
                    Margin="0 10 0 0">
            <Button x:Name="SimpleButton" Margin="0 0 10 0" Click="Simple_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="간단 방식"/>
            </Button>
            <Button x:Name="OriginalButton" Click="Original_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="원래 방식"/>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 18 0 0">
            <Button Margin="0 0 10 0" Click="Ok_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="확인"/>
            </Button>
            <Button Click="Cancel_Click">
                <TextBlock Style="{StaticResource ControlButtonText}" Text="취소"/>
            </Button>
        </StackPanel>
    </StackPanel>
</mah:MetroWindow>
