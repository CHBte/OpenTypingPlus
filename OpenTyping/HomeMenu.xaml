<UserControl x:Class="OpenTyping.HomeMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:OpenTyping"
             mc:Ignorable="d"
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <UserControl.Resources>
        <local:KeyPosToKeyConverter x:Key="KeyPosToKeyDataConverter"/>
        <Style x:Key="StatTile" TargetType="mah:Tile">
            <Setter Property="TitleFontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource NanumGothic}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0 0 7 0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="15 5 15 5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="5 10 0 15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Row="0"
                   Grid.Column="0"
                   Grid.RowSpan="2"
                   Source="{StaticResource AppLogo}"
                   Height="85"
                   Margin="0 0 13 0"/>
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Text="열린타자+"
                       Style="{StaticResource NormalTextBlock}" 
                       FontWeight="Light" 
                       FontSize="42pt"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text=": 현대적인 오픈 소스 타자 연습 프로그램"
                       Style="{StaticResource NormalTextBlock}"
                       FontSize="15pt"/>
        </Grid>
        <!-- `자판 표시`(<260927_9>·<260927_10>·<260927_10.1>): 큰 제목 글씨("열린타자+")의 오른쪽,
             오른쪽·위쪽 정렬 — 자리연습·음절연습·문장연습·긴글연습 화면과 같은 위치. -->
        <local:KeyLayoutIndicator x:Name="KeyLayoutIndicator"
                                  Grid.Row="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0 10 10 0"/>

        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#ced4da"
                Background="#f1f3f5"
                CornerRadius="5"
                Margin="20 10 20 20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <mah:Tile Style="{StaticResource StatTile}"
                          Title="가장 많이 틀린 키"
                          Background="#f03e3e">
                    <local:KeyBox x:Name="MostIncorrectKey"
                                  Key="{Binding Path=Stats.MostIncorrect.Key, 
                                                Source={x:Static local:MainWindow.CurrentKeyLayout},
                                                Converter={StaticResource KeyPosToKeyDataConverter}}"
                                  Foreground="Black"
                                  Width="50"
                                  Margin="0 0 0 60"/>
                </mah:Tile>
                <mah:Tile Style="{StaticResource StatTile}"
                          Title="평균 타속"
                          Background="#1c7ed6">
                    <TextBlock x:Name="AverageTypingSpeed"
                               Text="{Binding Path=Stats.AverageTypingSpeed,
                                              Source={x:Static local:MainWindow.CurrentKeyLayout}}"
                               FontFamily="{StaticResource NanumBarunGothic}"
                               FontSize="30pt"
                               Foreground="White"/>
                </mah:Tile>
                <mah:Tile Style="{StaticResource StatTile}"
                          Title="평균 정확도"
                          Background="#37b24d">
                    <TextBlock x:Name="AverageAccuracy"
                               Text="{Binding Path=Stats.AverageAccuracy,
                                              Source={x:Static local:MainWindow.CurrentKeyLayout},
                                              StringFormat={}{0}%}"
                               FontFamily="{StaticResource NanumBarunGothic}"
                               FontSize="30pt"
                               Foreground="White"/>
                </mah:Tile>
                <mah:Tile Style="{StaticResource StatTile}"
                          Title="연습한 문장 수"
                          Background="#f76707">
                    <TextBlock x:Name="SentencePracticeCount"
                               Text="{Binding Path=Stats.SentencePracticeCount,
                                              Source={x:Static local:MainWindow.CurrentKeyLayout}}"
                               FontFamily="{StaticResource NanumBarunGothic}"
                               FontSize="30pt"
                               Foreground="White"/>
                </mah:Tile>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>