<mah:MetroWindow x:Class="OpenTyping.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:OpenTyping"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="열린타자+"
                 Style="{StaticResource WindowTitleStyle}"
                 FontFamily="{StaticResource NanumGothic}"
                 Width="800"
                 Height="502"
                 MinWidth="800"
                 MinHeight="502"
                 ResizeMode="CanResize"
                 Icon="{StaticResource AppIcon}">
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <!-- '정보' 버튼: 오른쪽 아래 귀퉁이가 접힌 종이 문서 아이콘 (<260718_11>).
                 WindowCommands가 항목 사이에 세로 구분선을 자동으로 넣어 '정보'와 '설정'이 나뉜다. -->
            <Button x:Name="InfoButton"
                    Click="InfoButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Width="15"
                          Height="19"
                          Stretch="None"
                          VerticalAlignment="Center"
                          Stroke="White"
                          StrokeThickness="2.1"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M1,1 L14,1 L14,13 L9,18 L1,18 Z
                                M14,13 L9,13 L9,18
                                M4.5,6.5 L10.5,6.5
                                M4.5,9.5 L10.5,9.5
                                M4.5,12.5 L7.5,12.5"/>
                    <TextBlock FontFamily="{StaticResource NanumGothic}"
                               Text="정보"
                               FontSize="13pt"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="4 0 0 0"
                               VerticalAlignment="Top"/>
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="19"
                               Height="19"
                               Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, 
                                              Path=Foreground}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Fill" 
                                         Visual="{iconPacks:Modern Cog}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontFamily="{StaticResource NanumGothic}"
                               Text="설정"
                               FontSize="13pt"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="4 0 0 0"
                               VerticalAlignment="Top"/>
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="472">
            <TabControl x:Name="MenuTabControl"
                        Style="{DynamicResource MahApps.Styles.TabControl.Animated}">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                               Width="35" 
                               Height="25">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform"
                                         Visual="{iconPacks:Modern Home}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Label Style="{StaticResource TabItemLabel}"
                           Content="대문"/>
                </StackPanel>
            </TabItem.Header>
            <local:HomeMenu x:Name="HomeMenu"/>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                               Width="50" 
                               Height="25">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" 
                                         Visual="{iconPacks:FontAwesome KeyboardRegular}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Label Style="{StaticResource TabItemLabel}"
                           Content="자리연습"/>
                </StackPanel>
            </TabItem.Header>
            <local:KeyPracticeMenu x:Name="KeyPracticeMenu"/>
        </TabItem>
        <TabItem x:Name="SyllablePracticeTabItem">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Grid Margin="2 0 6 0">
                        <TextBlock FontSize="14pt"
                                   FontFamily="{StaticResource NanumBarunGothic}"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, Path=(TextElement.Foreground)}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0 2 0 0">가</TextBlock>
                        <Border Width="26"
                                Height="26"
                                CornerRadius="3"
                                BorderBrush="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, Path=(TextElement.Foreground)}"
                                BorderThickness="2"/>
                    </Grid>
                    <Label Style="{StaticResource TabItemLabel}"
                           Content="음절연습"/>
                </StackPanel>
            </TabItem.Header>
            <local:SyllablePracticeMenu x:Name="SyllablePracticeMenu"/>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                               Width="32" 
                               Height="25"
                               Margin="0 0 2 0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" 
                                         Visual="{iconPacks:FontAwesome Kind=PencilSolid}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Label Style="{StaticResource TabItemLabel}"
                           Content="문장연습"/>
                </StackPanel>
            </TabItem.Header>
            <local:SentencePracticeMenu x:Name="SentencePracticeMenu"/>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource TabItemIconRectangle}" 
                               Width="35" 
                               Height="25">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" 
                                         Visual="{iconPacks:FontAwesome BookSolid}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Label Style="{StaticResource TabItemLabel}"
                           Content="긴글연습"/>
                </StackPanel>
            </TabItem.Header>
            <local:ArticlePracticeMenu x:Name="ArticlePracticeMenu"/>
        </TabItem>
    </TabControl>
        <!-- 자식 모달(2단계 창)이 떠 있는 동안만 보이는 반투명 회색 오버레이: 내용의 채도를 낮춰
             비활성 상태를 표현한다 (<260718_7-1>). 히트테스트에서 제외한다. -->
        <Rectangle x:Name="DesaturateOverlay"
                   Fill="#808080"
                   Opacity="0.4"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</mah:MetroWindow>